{
  "name": "vexa-player",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A private, offline desktop video wall player",
  "author": "Vexa",
  "license": "UNLICENSED",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "test:local": "node scripts/start-local.cjs",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/desktop-smoke.cjs",
    "test:downloads": "npm run build && node scripts/downloads-smoke.cjs",
    "test:x-auth": "npm run build && node scripts/x-auth-smoke.cjs",
    "test:capacity": "npm run build && node scripts/capacity-smoke.cjs",
    "test:package": "node scripts/check-package.cjs",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && node scripts/package.cjs --dir",
    "dist:win": "npm run build && node scripts/package.cjs --win nsis --x64",
    "dist:mac": "npm run build && node scripts/package.cjs --mac dmg"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ffmpeg-static": "5.3.0",
    "sql.js": "1.15.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "pinia": "4.1.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.2.6"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.vexa.player",
    "productName": "Vexa Player",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json",
      "docs/THIRD_PARTY_NOTICES.md",
      "docs/licenses/**/*",
      "!node_modules/sql.js/dist/{sql-asm*,sql-wasm-browser*,sql-wasm-debug*,sql-wasm-inline*,worker.*,*.zip}"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Vexa-Player-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "artifactName": "Vexa-Player-${version}-macOS-${arch}.${ext}"
    }
  }
}
